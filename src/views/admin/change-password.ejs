<%- include('partials/header') %>

<div class="page-head">
  <h1>Şifre Değiştir</h1>
  <a class="button button-secondary" href="/admin">Panele Dön</a>
</div>

<section class="panel">
  <% if (error) { %>
    <p class="alert" role="alert"><%= error %></p>
  <% } %>
  <% if (success) { %>
    <p class="alert alert-success" role="status"><%= success %></p>
  <% } %>
  <form action="/admin/change-password" method="post" class="form" autocomplete="off" data-change-password-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>
      Mevcut Şifre
      <input type="password" name="currentPassword" autocomplete="current-password" required autofocus>
    </label>
    <label>
      Yeni Şifre
      <input type="password" name="newPassword" autocomplete="new-password" minlength="10" required aria-describedby="password-policy">
      <span class="field-help" id="password-policy"><%= passwordPolicyText %></span>
      <p class="alert admin-password-hint" role="alert" data-password-policy-hint hidden></p>
    </label>
    <label>
      Yeni Şifre (Tekrar)
      <input type="password" name="newPasswordConfirm" autocomplete="new-password" minlength="10" required>
      <p class="alert admin-password-hint" role="alert" data-password-match-hint hidden></p>
    </label>
    <p class="field-help">Şifre değişince diğer cihazlardaki admin oturumları kapatılır. Saatte en fazla 5 hatalı deneme, 3 saatte en fazla 2 değişiklik yapılabilir.</p>
    <button type="submit" data-change-password-submit disabled>Şifreyi Güncelle</button>
  </form>
</section>

<script src="/public/tema10/js/admin-change-password.js?v=20260915-1"></script>
<%- include('partials/footer') %>
