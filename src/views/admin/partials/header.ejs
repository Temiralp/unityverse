<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Unityverse Admin</title>
  <link rel="stylesheet" href="/admin.css?v=20260810-1">
  <% if (currentPath && (currentPath.startsWith('/admin/blog') || currentPath.startsWith('/admin/products'))) { %>
    <link rel="stylesheet" href="/vendor/jodit/jodit.min.css">
  <% } %>
  <% if (adminUser) { %>
    <script src="/public/tema10/js/admin-navigation.js?v=20260810-1" defer></script>
  <% } %>
</head>
<body>
  <header class="topbar">
    <% const navItems = [
      { href: '/admin/products', label: 'Kurslar' },
      { href: '/admin/corporate-references', label: 'Kurumsal Referanslar' },
      { href: '/admin/categories', label: 'Kategoriler' },
      { href: '/admin/blog', label: 'Blog' },
      { href: '/admin/members', label: 'Üyeler' },
      { href: '/admin/registrations', label: 'Eğitim Kayıtları' },
      { href: '/admin/pending-checkouts', label: 'Yarım Kalan Ödemeler' },
      { href: '/admin/crm', label: 'CRM Takip' },
      { href: '/admin/coupons', label: 'Kuponlar' },
      { href: '/admin/leads', label: 'Başvurular' }
    ]; %>
    <a class="brand" href="/admin" aria-label="Unityverse Admin ana panel" data-admin-brand>
      <span class="brand-mark">U</span>
      <span>Unityverse Admin</span>
    </a>
    <% if (adminUser) { %>
      <button
        class="admin-nav-toggle"
        type="button"
        aria-controls="admin-menu"
        aria-expanded="false"
        aria-label="Admin menüsünü aç"
        data-admin-nav-toggle
        hidden
      >
        <span class="admin-nav-toggle__icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
        <span class="admin-sr-only">Menü</span>
      </button>
      <div class="admin-menu" id="admin-menu" data-admin-menu>
        <nav class="admin-nav" aria-label="Admin navigasyon">
          <% navItems.forEach((item) => { const isActive = currentPath && currentPath.startsWith(item.href); %>
            <a
              href="<%= item.href %>"
              class="<%= isActive ? 'is-active' : '' %>"
              <% if (isActive) { %>aria-current="page"<% } %>
            >
              <%= item.label %>
            </a>
          <% }) %>
        </nav>
        <div class="admin-account">
          <span><%= adminUser.name || adminUser.email %></span>
          <form action="/admin/logout" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="logout-button">Çıkış</button>
          </form>
        </div>
      </div>
    <% } %>
  </header>
  <main class="page">
