<%- include('../partials/header') %>

<div class="page-head">
  <h1><%= pageTitle %></h1>
  <a class="button button-secondary" href="/admin/products">Geri Dön</a>
</div>

<section class="panel">
  <% if (error) { %>
    <p class="alert" role="alert"><%= error %></p>
  <% } %>

  <%
    const courseStatus = product && product.status === 'PUBLISHED' ? 'PUBLISHED' : 'DRAFT';
    const hasPublishedDuration = Array.isArray(productVariants) && productVariants.some((duration) => (
      duration.status === 'PUBLISHED'
      || duration.isActive !== false
        && duration.variantProduct
        && duration.variantProduct.status === 'PUBLISHED'
    ));
  %>
  <form method="post" action="<%= action %>" class="form grid-form" enctype="multipart/form-data" data-product-form data-managed-variant-group="<%= hasManagedVariantGroup ? 'true' : 'false' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="managedVariantGroup" value="<%= hasManagedVariantGroup ? '1' : '0' %>">
    <label class="wide">
      Başlık
      <input name="title" value="<%= product ? product.title || '' : '' %>" required>
    </label>
    <label>
      Ürün Kodu
      <input name="code" value="<%= product ? product.code || '' : '' %>" placeholder="Örn: UNITY-101">
    </label>
    <label>
      Slug
      <input name="slug" value="<%= product ? product.slug || '' : '' %>" placeholder="Boş bırakılırsa otomatik oluşturulur">
    </label>
    <label>
      Kategori
      <select name="categoryId">
        <option value="">Seçilmedi</option>
        <% categories.forEach((category) => { %>
          <option value="<%= category.id %>" <%= String(product && product.categoryId || '') === String(category.id) ? 'selected' : '' %>><%= category.name %></option>
        <% }) %>
      </select>
    </label>
    <label>
      Kurs Durumu
      <select name="status" data-parent-product-status required>
        <option value="PUBLISHED" <%= courseStatus === 'PUBLISHED' ? 'selected' : '' %>>Yayında</option>
        <option value="DRAFT" <%= courseStatus === 'DRAFT' ? 'selected' : '' %>>Taslak</option>
      </select>
    </label>
    <p class="field-help wide">Ana kurs taslaksa hiçbir eğitim süresi katalogda görünmez. Ana kursu taslağa aldığınızda mevcut sürelerin tamamı da taslağa alınır; ana kursu yayınlamak sürelerin durumunu değiştirmez.</p>
    <% if (hasManagedVariantGroup && courseStatus === 'PUBLISHED' && !hasPublishedDuration) { %>
      <p class="alert wide" role="status">Kurs yayında, fakat yayında eğitim süresi olmadığı için katalogda görünmüyor.</p>
    <% } %>
    <label>
      İndirim Tipi
      <select name="discountType">
        <option value="" <%= !product || !product.discountType ? 'selected' : '' %>>İndirim yok</option>
        <option value="PERCENT" <%= product && product.discountType === 'PERCENT' ? 'selected' : '' %>>Yüzde</option>
        <option value="AMOUNT" <%= product && product.discountType === 'AMOUNT' ? 'selected' : '' %>>Tutar</option>
      </select>
    </label>
    <label>
      İndirim Değeri
      <input name="discountValue" type="number" step="0.01" min="0" value="<%= product && product.discountValue != null ? product.discountValue : '' %>" placeholder="Yüzde için 20, tutar için 1500">
    </label>
    <label>
      KDV (%)
      <input name="vatRate" type="number" step="0.01" min="0" value="<%= product && product.vatRate != null ? product.vatRate : '20' %>">
    </label>
    <label>
      Havale İndirimi (%)
      <input name="bankTransferDiscountRate" type="number" step="0.01" min="0" max="99.99" value="<%= product && product.bankTransferDiscountRate != null ? product.bankTransferDiscountRate : '10' %>" required>
    </label>
    <%
      const durationRows = Array.isArray(productVariants) && productVariants.length
        ? productVariants
        : [{
          id: '',
          label: product ? product.duration || '' : '',
          price: product && product.price != null ? product.price : '',
          status: courseStatus,
          sortOrder: 0,
          isDefault: true
        }];
      const selectedDefaultDurationIndex = Math.max(
        0,
        durationRows.findIndex((duration) => duration.isDefault)
      );
    %>
    <section class="wide product-durations" data-product-durations>
      <div class="product-content-builder__head">
        <div>
          <h2>Eğitim Süreleri</h2>
          <p id="product-duration-help">Her süre için fiyat ve yayın durumunu belirleyin. Yalnızca yayında olan süreler kurs sayfasında gösterilir.</p>
        </div>
        <button type="button" class="button button-secondary" data-add-duration>Süre Ekle</button>
      </div>
      <div class="product-duration-list" data-duration-list aria-describedby="product-duration-help">
        <% durationRows.forEach((duration, index) => { %>
          <div class="product-duration-row" data-duration-row role="group" aria-label="Eğitim süresi <%= index + 1 %>">
            <%
              const durationPrice = duration.price != null
                ? duration.price
                : duration.variantProduct && duration.variantProduct.price != null
                  ? duration.variantProduct.price
                  : '';
              const durationStatus = duration.status === 'DRAFT'
                || duration.isActive === false
                || duration.variantProduct && duration.variantProduct.status === 'DRAFT'
                ? 'DRAFT'
                : 'PUBLISHED';
            %>
            <input type="hidden" name="variants[<%= index %>][id]" value="<%= duration.id || '' %>" data-field="id">
            <input type="hidden" name="variants[<%= index %>][variantProductId]" value="<%= duration.variantProductId || '' %>" data-field="variantProductId">
            <input type="hidden" name="variants[<%= index %>][isActivePresent]" value="1" data-field="isActivePresent">
            <input type="hidden" name="variants[<%= index %>][isActive]" value="<%= durationStatus === 'PUBLISHED' ? '1' : '0' %>" data-field="isActive">
            <label>
              Süre
              <input name="variants[<%= index %>][label]" data-field="label" value="<%= duration.label || '' %>" placeholder="30 saat, 4 ay vb." maxlength="80" required>
            </label>
            <label>
              Fiyat (TL)
              <input name="variants[<%= index %>][price]" data-field="price" type="number" inputmode="decimal" min="0.01" step="0.01" value="<%= durationPrice %>" required>
            </label>
            <label>
              Durum
              <select name="variants[<%= index %>][status]" data-field="status" required>
                <option value="PUBLISHED" <%= durationStatus === 'PUBLISHED' ? 'selected' : '' %>>Yayında</option>
                <option value="DRAFT" <%= durationStatus === 'DRAFT' ? 'selected' : '' %>>Taslak</option>
              </select>
            </label>
            <label>
              Sıralama
              <input name="variants[<%= index %>][sortOrder]" data-field="sortOrder" type="number" min="0" step="1" value="<%= duration.sortOrder || 0 %>">
            </label>
            <label class="check product-duration-default">
              <input type="radio" name="defaultVariantIndex" value="<%= index %>" <%= index === selectedDefaultDurationIndex ? 'checked' : '' %> data-field="isDefault">
              Varsayılan
            </label>
            <button type="button" class="button button-danger" data-remove-duration aria-label="Bu eğitim süresini kaldır" <%= durationRows.length <= 1 ? 'hidden' : '' %>>Kaldır</button>
          </div>
        <% }) %>
      </div>
      <p class="admin-sr-only" role="status" aria-live="polite" data-duration-status-message></p>
    </section>
    <label>
      Eğitim Tipi
      <input name="lessonType" value="<%= product ? product.lessonType || '' : '' %>" placeholder="Online, yüz yüze">
    </label>
    <label>
      Sertifikat
      <input name="certificate" value="<%= product ? product.certificate || '' : '' %>">
    </label>
    <label>
      Kurs Görseli
      <input name="productImage" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif">
      <span class="field-help">JPG, PNG, WebP, GIF veya AVIF · en fazla 5 MB</span>
    </label>
    <label>
      Görsel URL <span class="field-help">Opsiyonel</span>
      <input name="image" value="<%= product ? product.image || '' : '' %>" placeholder="Dosya seçmezseniz bu URL kullanılır">
    </label>
    <label>
      Sıralama
      <input name="sortOrder" type="number" value="<%= product ? product.sortOrder || 0 : 0 %>">
    </label>
    <% if (productImagePreviewUrl) { %>
      <div class="wide product-image-preview">
        <span>Mevcut kurs görseli</span>
        <img src="<%= productImagePreviewUrl %>" alt="" width="320" height="180">
        <small>Yeni dosya seçmezseniz mevcut görsel korunur.</small>
      </div>
    <% } %>
    <section class="wide product-content-builder" data-product-tabs>
      <div class="product-content-builder__head">
        <div>
          <h2>İçerik Sekmeleri</h2>
          <p>İlk üç sekmenin başlığı sabittir. Ek sekmeleri serbestçe yönetebilirsiniz.</p>
        </div>
        <button type="button" class="button button-secondary" data-add-tab>Tab Ekle</button>
      </div>
      <div data-tab-list>
        <% productTabs.forEach((tab, index) => { %>
          <section class="product-tab-editor" data-tab-editor data-system-key="<%= tab.systemKey || '' %>">
            <div class="product-tab-editor__head">
              <h3><%= tab.title %></h3>
              <% if (!tab.systemKey) { %>
                <div class="product-tab-editor__actions">
                  <button type="button" class="button button-secondary" data-move-tab="up">Yukarı</button>
                  <button type="button" class="button button-secondary" data-move-tab="down">Aşağı</button>
                  <button type="button" class="button button-danger" data-remove-tab>Tab Sil</button>
                </div>
              <% } else { %>
                <span class="field-help">Sabit sekme</span>
              <% } %>
            </div>
            <input type="hidden" name="tabs[<%= index %>][systemKey]" value="<%= tab.systemKey || '' %>">
            <% if (tab.systemKey) { %>
              <input type="hidden" name="tabs[<%= index %>][title]" value="<%= tab.title %>">
            <% } else { %>
              <label>
                Tab Başlığı
                <input name="tabs[<%= index %>][title]" value="<%= tab.title || '' %>" required>
              </label>
            <% } %>
            <label class="product-tab-editor__content">
              İçerik
              <textarea name="tabs[<%= index %>][content]" rows="14" data-product-editor><%= tab.content || '' %></textarea>
            </label>
          </section>
        <% }) %>
      </div>
    </section>

    <section class="wide product-outcomes" data-learning-outcomes>
      <div class="product-content-builder__head">
        <div>
          <h2>Ne Öğreneceksiniz</h2>
          <p>Kısa ve ölçülebilir kazanımları ayrı maddeler halinde ekleyin.</p>
        </div>
        <button type="button" class="button button-secondary" data-add-outcome>Madde Ekle</button>
      </div>
      <div data-outcome-list>
        <% learningOutcomes.forEach((outcome, index) => { %>
          <div class="product-outcome-row" data-outcome-row>
            <input name="learningOutcomes[<%= index %>][text]" value="<%= outcome.text || '' %>" aria-label="Öğrenme kazanımı">
            <button type="button" class="button button-danger" data-remove-outcome aria-label="Maddeyi sil">Sil</button>
          </div>
        <% }) %>
      </div>
    </section>

    <button type="submit"><%= submitLabel %></button>
  </form>
</section>

<template id="product-tab-template">
  <section class="product-tab-editor" data-tab-editor>
    <div class="product-tab-editor__head">
      <h3>Ek Sekme</h3>
      <div class="product-tab-editor__actions">
        <button type="button" class="button button-secondary" data-move-tab="up">Yukarı</button>
        <button type="button" class="button button-secondary" data-move-tab="down">Aşağı</button>
        <button type="button" class="button button-danger" data-remove-tab>Tab Sil</button>
      </div>
    </div>
    <input type="hidden" data-field="systemKey" value="">
    <label>
      Tab Başlığı
      <input data-field="title" required>
    </label>
    <label class="product-tab-editor__content">
      İçerik
      <textarea data-field="content" rows="14" data-product-editor></textarea>
    </label>
  </section>
</template>

<template id="product-outcome-template">
  <div class="product-outcome-row" data-outcome-row>
    <input data-field="text" aria-label="Öğrenme kazanımı">
    <button type="button" class="button button-danger" data-remove-outcome aria-label="Maddeyi sil">Sil</button>
  </div>
</template>

<template id="product-duration-template">
  <div class="product-duration-row" data-duration-row role="group">
    <input type="hidden" data-field="id" value="">
    <input type="hidden" data-field="variantProductId" value="">
    <input type="hidden" data-field="isActivePresent" value="1">
    <input type="hidden" data-field="isActive" value="1">
    <label>
      Süre
      <input data-field="label" placeholder="30 saat, 4 ay vb." maxlength="80" required>
    </label>
    <label>
      Fiyat (TL)
      <input data-field="price" type="number" inputmode="decimal" min="0.01" step="0.01" required>
    </label>
    <label>
      Durum
      <select data-field="status" required>
        <option value="PUBLISHED">Yayında</option>
        <option value="DRAFT">Taslak</option>
      </select>
    </label>
    <label>
      Sıralama
      <input data-field="sortOrder" type="number" min="0" step="1" value="0">
    </label>
    <label class="check product-duration-default">
      <input type="radio" name="defaultVariantIndex" data-field="isDefault">
      Varsayılan
    </label>
    <button type="button" class="button button-danger" data-remove-duration aria-label="Bu eğitim süresini kaldır">Kaldır</button>
  </div>
</template>

<script src="/vendor/jodit/jodit.min.js"></script>
<script src="/public/tema10/js/admin-product-editor.js?v=20260804-2"></script>
<%- include('../partials/footer') %>
