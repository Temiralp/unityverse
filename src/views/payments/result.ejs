<%- include('../partials/header', {
  useLegacyPaymentHeader: true,
  useHomepageNavbar: true,
  usePaymentResponsiveHeader: true
}) %>

<main class="uv-payment-page">
  <section class="uv-payment-hero uv-payment-hero--result">
    <div class="uv-shell uv-payment-hero__inner">
      <div>
        <nav class="uv-payment-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Ana Sayfa</a>
          <span aria-hidden="true">/</span>
          <span>Ödeme Sonucu</span>
        </nav>
        <p class="uv-eyebrow"><%= eyebrow %></p>
        <h1><%= title %></h1>
        <p><%= message %></p>
      </div>
      <% if (registration) { %>
        <span class="uv-payment-hero__badge">Kayıt #<%= registration.id %></span>
      <% } %>
    </div>
  </section>

  <section class="uv-payment-result-section">
    <div class="uv-shell">
      <article class="uv-payment-result uv-payment-result--<%= type %>">
        <span class="uv-payment-result__icon" aria-hidden="true">
          <i class="fa <%= type === 'success' ? 'fa-check' : 'fa-exclamation' %>"></i>
        </span>
        <h2><%= type === 'success' ? 'İşlem bilginiz alındı' : 'İşlemi tamamlayamadık' %></h2>
        <p>
          <%= type === 'success'
            ? resultMethod === 'bank'
              ? 'Havale/EFT bildiriminiz alındı; ödeme banka hareketi kontrol edildikten sonra kaydınıza yansır.'
              : 'Ödeme sonucu PayTR bildirimiyle doğrulanır ve kaydınıza otomatik yansır.'
            : 'Kart bilgilerinizi kontrol ederek tekrar deneyebilir veya danışman desteği alabilirsiniz.' %>
        </p>

        <% if (registration) { %>
          <dl>
            <div>
              <dt>Eğitim</dt>
              <dd><%= registration.courseTitle %></dd>
            </div>
            <div>
              <dt>Kayıt No</dt>
              <dd>#<%= registration.id %></dd>
            </div>
          </dl>
        <% } %>

        <div class="uv-payment-result__actions">
          <% if (paymentUrl) { %>
            <a class="btn-primary" href="<%= paymentUrl %>">Tekrar Dene</a>
          <% } %>
          <a class="btn-secondary" href="<%= courseUrl %>">Eğitimlere Dön</a>
        </div>
      </article>
    </div>
  </section>
</main>

<%- include('../partials/footer', { useLegacyPaymentFooter: true }) %>
