DATABASE_URL="postgresql://postgres:postgres@localhost:5432/unityverse?schema=public"
PORT=8000
# Local/direct Node: false. Production with same-host Nginx proxying to 127.0.0.1: 127.0.0.1
# Never use true or *; only list the actual proxy IP/CIDR.
TRUST_PROXY=false
PUBLIC_CSRF_ENFORCED=true
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-generated-secret"
ADMIN_EMAIL="admin@unityverseacademy.com"
ADMIN_PASSWORD="ChangeMe123!"
SMTP_HOST="smtp.yandex.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_TO="info@unityverseacademy.com"

# PayTR iframe API
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
PAYTR_TEST_MODE=1
# Public HTTPS root, for example your ngrok URL without a trailing slash.
PAYTR_PUBLIC_BASE_URL=""
# Required by PayTR because the current Member model has no address field.
PAYTR_DEFAULT_USER_ADDRESS="Türkiye"
# Local tests must use your public IPv4 address. Leave empty in production.
PAYTR_USER_IP=""
# Empty disables the application-level callback IP allowlist for local/ngrok use.
# Production: 185.187.184.84,212.252.97.250,213.74.97.150
PAYTR_ALLOWED_IPS=""
